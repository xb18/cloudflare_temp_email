name = "cloudflare_temp_email_mail_flags"
main = "src/worker.ts"
compatibility_date = "2025-04-01"
compatibility_flags = [ "nodejs_compat" ]
keep_vars = true

[vars]
PREFIX = "TMP"
DEFAULT_DOMAINS = []
DOMAINS = ["TEST.EXAMPLE.COM"]
CREATE_ADDRESS_DEFAULT_DOMAIN_FIRST = true
JWT_SECRET = "e2e-test-secret-key"
BLACK_LIST = ""
ENABLE_USER_CREATE_EMAIL = true
ENABLE_USER_DELETE_EMAIL = true
ENABLE_MAIL_GZIP = true
ENABLE_MAIL_READ_STATUS = true
ENABLE_MAIL_FLAG = true
DISABLE_ADMIN_PASSWORD_CHECK = true
ADMIN_PASSWORDS = '["e2e-admin-pass"]'
E2E_TEST_MODE = true

[[kv_namespaces]]
binding = "KV"
id = "e2e-test-kv-mail-flags-00000000-0000-0000-0000-000000000000"

[[d1_databases]]
binding = "DB"
database_name = "e2e-temp-email-mail-flags"
database_id = "e2e-test-db-mail-flags-00000000-0000-0000-0000-000000000000"
